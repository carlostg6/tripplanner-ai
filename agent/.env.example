# Variables de entorno del AgentCore Runtime (agentcore launch --env KEY=VALUE ...)
AWS_REGION=us-east-1
ORCHESTRATOR_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SPECIALIST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
MEMORY_ID=
# Pega aquí la salida ToolFunctionNames del stack SAM
TOOL_FUNCTIONS=CreateTrip=tripplanner-CreateTrip,GetTrips=tripplanner-GetTrips,UpdateTrip=tripplanner-UpdateTrip,CreateItinerary=tripplanner-CreateItinerary,UpdateItinerary=tripplanner-UpdateItinerary,CreateReservation=tripplanner-CreateReservation,GetReservations=tripplanner-GetReservations,UpdateReservation=tripplanner-UpdateReservation,GetPreferences=tripplanner-GetPreferences,SavePreferences=tripplanner-SavePreferences
# Solo local:
# ALLOW_INSECURE_LOCAL_USER=true
# LOCAL_CORS_ORIGIN=http://localhost:5173
