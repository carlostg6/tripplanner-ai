# Salidas del stack SAM (sam deploy) y del agente (agentcore deploy)
VITE_AWS_REGION=us-east-1
VITE_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/v1
VITE_USER_POOL_ID=us-east-1_XXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/tripplanner_orchestrator-XXXX

# Cómo llega el navegador al endpoint HTTP streaming de AgentCore:
#   cloudfront → mismo dominio del frontend, ruta /runtimes/* (recomendado, sin CORS)
#   direct     → https://bedrock-agentcore.<region>.amazonaws.com
#   local      → http://localhost:8080/invocations (python agent/main.py)
VITE_AGENT_MODE=cloudfront

# Solo desarrollo de interfaz sin AWS: datos y agente simulados en el navegador.
VITE_MOCK=false
